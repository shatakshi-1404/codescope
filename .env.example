# CodeScope settings. Every value has a safe local default, so this file is optional
# for running on your own computer. Copy to .env to customize.
#
#   development = API docs on, password-reset token shown in the UI (no email provider yet)
#   production  = strict secret check, docs off, reset tokens never exposed
# For a real deployment run ./deploy.sh: it writes a production .env with random secrets.
APP_ENV=development

POSTGRES_USER=codescope
POSTGRES_PASSWORD=codescope_dev_password
POSTGRES_DB=codescope

# The "change-me" prefix makes the API REFUSE to start if APP_ENV=production, on purpose.
JWT_SECRET=change-me-local-dev-only-secret-not-for-production-0123456789
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Where the web app is served. 127.0.0.1 = this computer only. Use 0.0.0.0 to expose it.
APP_BIND=127.0.0.1
APP_PORT=8080

# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173

# Set by deploy.sh when you pass a domain (enables automatic HTTPS through Caddy).
DOMAIN=

# Development-only host ports (docker-compose.dev.yml). Change them if they clash.
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000

# ---- Optional ----------------------------------------------------------------------------------
# Sign-in throttling per IP (a third of it per account). 0 turns it off.
# AUTH_RATE_LIMIT_PER_MINUTE=30
# Largest repository the analyzer accepts, in MB.
# MAX_REPO_MB=300
# Extra allowed web origins as a regex (only for a separately hosted frontend, e.g. Vercel previews).
# CORS_ORIGIN_REGEX=
