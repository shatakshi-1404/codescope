# Used only when the web app and the API are on DIFFERENT hosts (Vercel + Render).
# Vite reads this at BUILD time, so on Vercel set it under Project Settings -> Environment Variables,
# then redeploy. Leave it unset for Docker (nginx serves /api on the same host) and for `npm run dev`.
#
# The address of your Render backend (the "/api" part is added automatically if you leave it out):
VITE_API_URL=https://codescope-api.onrender.com
